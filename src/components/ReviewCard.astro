---
import ScoreBadge from './ScoreBadge.astro';
import { url, formatDate, type Review, type Article, type Taxonomies } from '../lib/data';

interface Props {
  entry: Review | Article;
  tax: Taxonomies;
}

const { entry, tax } = Astro.props;
const isReview = entry.collection === 'reviews';
const data = entry.data;
const review = isReview ? (entry as Review).data : undefined;
const venueName = review?.venue ? tax.venues.get(review.venue)?.data.name : undefined;
const cityName = review?.cities[0] ? tax.cities.get(review.cities[0])?.data.name : undefined;
const meta = isReview ? [venueName, cityName].filter(Boolean).join(' · ') : formatDate(data.date);
---

<article class="card" data-pagefind-ignore>
  <div class="card__media">
    {data.image ? <img src={data.image} alt={data.imageAlt ?? ''} loading="lazy" decoding="async" /> : <div class="card__placeholder" />}
  </div>
  {isReview && <ScoreBadge score={review!.score} reviewed={review!.reviewed} class="card__score" />}
  <div class="card__body">
    <h3 class="card__title"><a href={url.post(entry.id)}>{data.title}</a></h3>
    {meta && <p class="card__meta">{meta}</p>}
  </div>
</article>

<style>
  .card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #2d4256, #3b4f45);
  }
</style>
