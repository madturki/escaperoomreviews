---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <div class="container">
    <header class="page-head">
      <h1>We couldn't escape this one</h1>
      <p>The page you're looking for has moved or no longer exists.</p>
    </header>
    <p>
      <a class="button" href="/">Go to the home page</a>
      <a class="button button--ghost" href="/search/">Search reviews</a>
      <a class="button button--ghost" href="/map/">Find rooms near you</a>
    </p>
  </div>
  <script is:inline>
    (function () {
      var p = location.pathname;
      var rules = [
        [/^\/wp-content\/uploads\/(.+?)(-\d+x\d+)?\.(jpe?g|png|gif|webp|avif)$/i, '/images/$1.$3'],
        [/^\/(.+\/)?feed\/?$/, '/rss.xml'],
        [/^\/(blog\/)?page\/\d+\/?$/, '/blog/'],
        [/^\/author\/.*$/, '/'],
        [/^\/review\/.*$/, '/blog/'],
        [/^\/reviews\/cities\/.*$/i, '/category/city/'],
        [/^\/reviews\/locations\/.*$/i, '/category/location/'],
        [/^\/reviews\/genres\/.*$/i, '/category/genre/'],
      ];
      var lower = p.toLowerCase();
      if (lower !== p && /^\/reviews\//.test(lower)) return location.replace(lower);
      for (var i = 0; i < rules.length; i++) {
        if (rules[i][0].test(p)) return location.replace(p.replace(rules[i][0], rules[i][1]));
      }
    })();
  </script>
</BaseLayout>
