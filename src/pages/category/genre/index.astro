---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Gallery from '../../../components/Gallery.astro';
import { getReviews, getTaxonomies, url } from '../../../lib/data';

const [reviews, tax] = await Promise.all([getReviews(), getTaxonomies()]);
const items = [...tax.genres.values()].map((g) => ({
  href: url.genre(g.id),
  image: g.data.image,
  label: g.data.name,
  count: reviews.filter((r) => r.data.genres.includes(g.id)).length,
}));
---

<BaseLayout title="Escape rooms by genre" description="Browse our escape room reviews by theme: creepy, fantasy, historic, magic, pirates, space, and more.">
  <div class="container">
    <header class="page-head">
      <Breadcrumbs items={[{ label: 'Genres' }]} />
      <h1>Browse escape rooms by genre</h1>
      <p>Pick a theme to see every room we've played in that genre, sorted by our score.</p>
    </header>
    <Gallery items={items} />
  </div>
</BaseLayout>
