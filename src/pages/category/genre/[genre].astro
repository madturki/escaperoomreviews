---
import TermPage from '../../../layouts/TermPage.astro';
import { getReviews, getArticles, getTaxonomies, url } from '../../../lib/data';

export async function getStaticPaths() {
  const [reviews, articles, tax] = await Promise.all([getReviews(), getArticles(), getTaxonomies()]);
  return [...tax.genres.values()].map((genre) => ({
    params: { genre: genre.id },
    props: {
      genre,
      reviews: reviews.filter((r) => r.data.genres.includes(genre.id)),
      articles: articles.filter((a) => a.data.genres.includes(genre.id)),
      tax,
    },
  }));
}

const { genre, reviews, articles, tax } = Astro.props;
const name = genre.data.name;
const best = articles.find((article) => article.data.bestOfGenre === genre.id);
---

<TermPage
  title={`${name} Escape Rooms`}
  eyebrow="Genre"
  description={genre.data.description ?? `Our reviews and ratings of ${name.toLowerCase()} themed escape rooms, sorted by score.`}
  crumbs={[{ label: 'Genres', href: '/category/genre/' }, { label: name }]}
  reviews={reviews}
  articles={articles.filter((article) => article.data.bestOfGenre !== genre.id)}
  tax={tax}
>
  {
    best && (
      <p>
        <a class="button" href={url.post(best.id)}>
          {best.data.title}
        </a>
      </p>
    )
  }
</TermPage>
