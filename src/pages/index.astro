---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewList from '../components/ReviewList.astro';
import Gallery from '../components/Gallery.astro';
import VenueMap from '../components/VenueMap.astro';
import MailingList from '../components/MailingList.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../site.config';
import { getReviews, getArticles, getTaxonomies, buildPins, sortByScore, genreCover, isClosed, url } from '../lib/data';

const [reviews, articles, tax] = await Promise.all([getReviews(), getArticles(), getTaxonomies()]);
const reviewed = reviews.filter((r) => r.data.reviewed);
const verified = reviews.filter((r) => r.data.tags.some((t) => t.toLowerCase() === 'verified'));
const verifiedVenues = new Set(verified.flatMap((r) => (r.data.venue ? [r.data.venue] : [])));
const verifiedCities = new Set(verified.flatMap((r) => r.data.cities));
const latest = reviewed.filter((review) => !isClosed(review, tax)).slice(0, 8);
const topRated = sortByScore(reviewed.filter((review) => !isClosed(review, tax))).slice(0, 8);
const pins = buildPins(tax, reviews);
const genres = [...tax.genres.values()].map((g) => ({ href: url.genre(g.id), image: genreCover(reviews, g.id)?.image, label: g.data.name }));
const regions = [...tax.regions.values()].map((region) => ({
  region,
  count: reviews.filter((r) => r.data.region === region.id && r.data.reviewed).length,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout title="The Best Escape Rooms in Ontario" description={SITE.description} ads jsonLd={jsonLd}>
  <section class="hero" data-hero-slider aria-roledescription="carousel" aria-label="Featured">
    <div class="container">
      <div class="hero__slides">
        <article class="hero__slide is-active" data-slide aria-roledescription="slide" aria-label="1 of 3">
          <div class="hero__layout">
            <div>
              <p class="eyebrow">Christmas road trip</p>
              <h2>Five holiday rooms across Ontario</h2>
              <p>
                Niagara Falls, Woodstock, Kitchener, Barrie, and Sudbury. Each stop has a booking link and a pin on the map. These rooms are not scored
                reviews.
              </p>
              <div class="hero__actions">
                <a class="button" href="/christmas-escape-rooms-in-ontario/">See the road trip</a>
              </div>
            </div>
            <img
              class="hero__art hero__art--poster"
              src="/images/2026/11/the-last-christmas-niagara-escapement.jpg"
              alt="The Last Christmas poster for Niagara Escapement in Niagara Falls"
              width="640"
              height="640"
            />
          </div>
        </article>

        <article class="hero__slide" data-slide aria-roledescription="slide" aria-label="2 of 3" aria-hidden="true" inert>
          <p class="eyebrow">Escape Room Reviews</p>
          <h1>Honest, room-by-room reviews of the best escape rooms</h1>
          <p>
            We're David and Danielle, a husband and wife team who have played nearly 150 escape rooms as a duo across Ontario, Quebec, Saskatchewan, New
            York, and Spain. We score every room on theme, puzzles, environment, and the little extras.
          </p>
          <div class="hero__actions">
            <a class="button" href="/top-50-escape-rooms-in-ontario/">Top 50 in Ontario</a>
            <a class="button button--ghost" href="/map/">Find rooms near me</a>
          </div>
          <ul class="stats">
            <li><strong>{reviewed.length}</strong><span>rooms reviewed</span></li>
            <li><strong>{verifiedVenues.size}</strong><span>venues visited</span></li>
            <li><strong>{verifiedCities.size}</strong><span>cities</span></li>
            <li><strong>74.1%</strong><span>escape rate as a duo</span></li>
          </ul>
        </article>

        <article class="hero__slide" data-slide aria-roledescription="slide" aria-label="3 of 3" aria-hidden="true" inert>
          <div class="hero__layout">
            <div>
              <p class="eyebrow">From the reviews</p>
              <h2>The most immersive rooms</h2>
              <p>
                Sets, sound, and story that hold together. The Ontario rooms where the walls, the lighting, and the puzzles all belong to the same
                place.
              </p>
              <div class="hero__actions">
                <a class="button" href="/most-immersive-escape-rooms-in-ontario/">Read the list</a>
              </div>
            </div>
            <img
              class="hero__art"
              src="/images/2021/11/IMG_5836.jpg"
              alt="A wooden ship interior with a staircase, ship's wheel, and ocean visible through the windows"
              width="1200"
              height="800"
            />
          </div>
        </article>
      </div>

      <div class="hero__controls">
        <button type="button" class="hero__nav" data-prev aria-label="Previous slide">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="hero__dots">
          <button type="button" class="hero__dot" data-dot aria-label="Christmas road trip" aria-current="true"></button>
          <button type="button" class="hero__dot" data-dot aria-label="About these reviews"></button>
          <button type="button" class="hero__dot" data-dot aria-label="The most immersive rooms"></button>
        </div>
        <button type="button" class="hero__nav" data-next aria-label="Next slide">
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  </section>
  <script>
    const root = document.querySelector<HTMLElement>('[data-hero-slider]');
    if (root) {
      const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
      const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
      let index = 0;

      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === index;
          slide.classList.toggle('is-active', active);
          slide.toggleAttribute('inert', !active);
          if (active) slide.removeAttribute('aria-hidden');
          else slide.setAttribute('aria-hidden', 'true');
        });
        dots.forEach((dot, i) => {
          if (i === index) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      };

      root.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
      root.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
      dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
      root.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          show(index - 1);
          event.preventDefault();
        }
        if (event.key === 'ArrowRight') {
          show(index + 1);
          event.preventDefault();
        }
      });
    }
  </script>

  <div class="container">
    <section class="section">
      <div class="section__head">
        <h2>Top rated escape rooms</h2>
        <a href="/top-50-escape-rooms-in-ontario/">Top 50 Ontario</a>
      </div>
      <ReviewList entries={topRated} tax={tax} />
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Latest reviews</h2>
        <a href="/reviews/">All reviews</a>
      </div>
      <ReviewList entries={latest} tax={tax} />
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Browse escape rooms by genre</h2>
        <a href="/category/genre/">All genres</a>
      </div>
      <Gallery items={genres} />
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Escape room reviews near you</h2>
        <a href="/map/">Open the full map</a>
      </div>
      <ul class="chips region-chips">
        {
          regions.map(({ region, count }) => (
            <li>
              <a class="chip" href={url.region(region.id)}>
                {region.data.name} <span class="chip__count">{count}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <VenueMap pins={pins} height="440px" />
    </section>

    <AdSlot />

    <MailingList />

    <section class="section about">
      <div>
        <h2>Who we are</h2>
        <p>
          We're a husband and wife team that loves escape rooms! Nothing has been better for improving our communication and problem-solving skills than
          doing back-to-back escape rooms. As some of our hosts can attest, we don't always agree on the best way to solve a puzzle.
        </p>
        <p>
          Our <strong>escape room reviews</strong> are based on our experience and preferences and, while we try to be as objective as possible, our
          readers will have subjectively different opinions from us, and visit experiences can vary from time to time.
        </p>
      </div>
      <div>
        <h2>Are you an escape room owner?</h2>
        <p>
          When people read reviews on our site they click that "Book now" button. Having your rooms reviewed here helps people find your location and
          your rooms.
        </p>
        <p>
          <a class="button" href="/inquire/">Get your rooms reviewed</a>
          <a class="button button--ghost" href="/professional-escape-room-analysis-in-ontario/">Professional room analysis</a>
        </p>
      </div>
    </section>

    {
      articles.length > 0 && (
        <section class="section">
          <div class="section__head">
            <h2>From the blog</h2>
            <a href="/blog/">More articles</a>
          </div>
          <ReviewList entries={articles.slice(0, 8)} tax={tax} />
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .region-chips {
    margin-bottom: 1rem;
  }

  .about {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .about .button {
    margin: 0 0.5rem 0.5rem 0;
  }
</style>
