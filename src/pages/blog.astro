---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewList from '../components/ReviewList.astro';
import { getArticles, getTaxonomies } from '../lib/data';

const [articles, tax] = await Promise.all([getArticles(), getTaxonomies()]);
---

<BaseLayout title="Articles" description="Escape room articles, city guides, and best-of lists, newest first.">
  <div class="container">
    <header class="page-head">
      <Breadcrumbs items={[{ label: 'Blog' }]} />
      <h1>Articles</h1>
      <p>{articles.length} articles, newest first.</p>
    </header>
    <ReviewList entries={articles} tax={tax} empty="No articles yet." />
  </div>
</BaseLayout>
